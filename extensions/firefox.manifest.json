{
  "manifest_version": 3,
  "name": "SubtitleDesk — Tìm phụ đề",
  "version": "0.1.0",
  "description": "Gửi trang hoặc văn bản đã chọn sang SubtitleDesk khi bạn yêu cầu.",
  "permissions": ["activeTab", "contextMenus", "nativeMessaging"],
  "action": {"default_popup": "popup.html", "default_title": "SubtitleDesk"},
  "background": {"scripts": ["background.js"]},
  "browser_specific_settings": {
    "gecko": {
      "id": "subtitledesk@local.invalid",
      "strict_min_version": "128.0",
      "data_collection_permissions": {"required": ["none"]}
    }
  }
}
